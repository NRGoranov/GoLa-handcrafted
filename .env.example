# Admin panel (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Inquiry email — comma-separated inboxes
EMAIL_USER=
EMAIL_PASSWORD=
TO_EMAIL=rgoranov@gmail.com,gbozhana@gmail.com

# Supabase (can be the same project as NRG Portfolio wishlist)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Settings → API → Secret keys)
SUPABASE_SECRET_KEY=

# Legacy names also supported:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Trader identity published on /legal-notice. Leave blank rather than inventing them.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_UIC=
LEGAL_VAT_ID=
PUBLIC_CONTACT_EMAIL=

# Consumer prices. true = amounts already include VAT. false = VAT is not charged.
# Leave empty until you know. The site will not claim a VAT treatment while this is empty.
NEXT_PUBLIC_PRICE_INCLUDES_VAT=
